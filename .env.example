# Populate only in your secure local environment or untracked .env.local.
OPENAI_API_KEY=
INTERVIEW_MODEL=gpt-5.4-mini
# On-demand full draft generation, evidence audit and coverage assessment.
DRAFT_MODEL=gpt-6.1-terra
WORKFLOW_AUDIT_MODEL=gpt-5.4
# Managed interview team (takes precedence for the current interview/workflow UI).
AGENT_INTERVIEW_MODEL=gpt-6-luna
AGENT_COVERAGE_MODEL=gpt-6-luna
AGENT_PROCESS_MODEL=gpt-6.1-terra
AGENT_DOCUMENT_MODEL=gpt-6.1-terra
TRANSCRIPTION_MODEL=gpt-transcribe
# Optional comma-separated spelling hints for gpt-transcribe (empty disables).
TRANSCRIPTION_KEYWORDS=GPFS,GP Fund Solutions,Entrilia,Allvue
# Optional local-owner development access. Both must be explicitly set;
# do not enable this mode on a hosted or shared deployment.
COLLECTOR_DEPLOYMENT_MODE=
KNOWLEDGE_LOCAL_OWNER=
