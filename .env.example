# Populate only in your secure local environment or untracked .env.local.
# Set to 0 to use the earlier live coverage and resume behavior.
INTERVIEW_MEMORY_ENABLED=1
OPENAI_API_KEY=
INTERVIEW_MODEL=gpt-5.4-mini
# On-demand full draft generation, evidence audit and coverage assessment.
DRAFT_MODEL=gpt-6.1-terra
WORKFLOW_AUDIT_MODEL=gpt-5.4
# Managed interview team (takes precedence for the current interview/workflow UI).
AGENT_INTERVIEW_MODEL=gpt-6-luna
AGENT_COVERAGE_MODEL=gpt-6-luna
AGENT_PROCESS_MODEL=gpt-6.1-terra
AGENT_DOCUMENT_MODEL=gpt-6.1-terra
TRANSCRIPTION_MODEL=gpt-transcribe
# Spoken interviews: "live" (GPT-Live speaks while the managed team keeps the notes and gates;
# default) or "reviewed" (every spoken line is a reviewed lead turn read by a TTS voice).
VOICE_MODE=live
# Reviewed voice only: the pause, in milliseconds, that ends your turn (1000-5000; default 1800).
# A longer pause adds the same time to the wait for every reply.
# VOICE_PAUSE_MS=1800
# Live voice only: on (default) or off. Corrects fund terms and configured names in live captions
# using the participant's own audio. The live captioner takes no spelling hints ("KYC" can be
# captioned "kite"), so each finished answer's audio is transcribed again with TRANSCRIPTION_MODEL,
# hinted with the fund terms, the process name and TRANSCRIPTION_KEYWORDS (30 terms at most, so the
# first 17 keywords when a process name is set); where that reading has one of those terms in place
# of a misheard word, that word is replaced. Every other word stays as captioned. The audio
# already goes to the AI service in live voice; muted speech is never sent. Off keeps the live
# captions exactly as they arrive and records nothing on the page.
# LIVE_CAPTION_CHECK=on
# Optional comma-separated names and terms to spell right. Dictation and reviewed voice get them as
# spelling hints. In live voice they join the fund terms and the process name in the interviewer's
# glossary and in the caption check above, which can put one of them in place of a misheard caption
# word. Left out, these four are used; left empty (TRANSCRIPTION_KEYWORDS=), none are, and the fund
# terms are still used in live voice.
TRANSCRIPTION_KEYWORDS=GPFS,GP Fund Solutions,Entrilia,Allvue
# The local owner can revise filed processes and view Agents in Settings.
# Set both options only for a trusted, single-user loopback installation.
COLLECTOR_DEPLOYMENT_MODE=
KNOWLEDGE_LOCAL_OWNER=

# Local usage thresholds, in tokens. Zero disables the threshold.
DAILY_TOKEN_CAP=0
INTERVIEW_TOKEN_CAP=0
# Requests to the AI service in flight at once (2-32, default 24). Notes, maps and their
# source checks leave two of them free for questions, transcription and voice.
# COLLECTOR_PROVIDER_SLOTS=24
# Workflow maps drawn at once across interviews (1-8, default 2).
# COLLECTOR_MAP_WORKERS=2
# Notes written at once across interviews (1-8, default 2). Raise it for a server shared by several people.
# COLLECTOR_NOTES_WORKERS=2
# auto, on or off for the structured model reasoning parameter.
COLLECTOR_MODEL_REASONING=auto
# on (default) or off. After a file is added, its first review, its question and the first notes and
# map from it are sent on the provider's priority tier: the same model and request, written about
# twice as fast, billed at the provider's priority rate. A project that does not have the tier is
# served the ordinary way without any setting.
# COLLECTOR_FAST_TIER=on
# Developer event traces in work/raw-trace. Values: off, metadata, content.
# Without an explicit setting the app uses work/raw-trace-mode.txt or defaults to metadata.
# Content records interview wording and model exchanges on this computer.
# RAW_TRACE_MODE=metadata
# Optional two-letter code for recorded answer transcription.
TRANSCRIPTION_LANGUAGE=

# When the participant wraps up, the page asks for the first half of the draft so that
# Create draft waits only for its source check. "off" leaves the whole draft to the click
# (no tokens are spent on a draft nobody asks for).
# DRAFT_PREPARE=on
# Optional independent model aliases for draft source and coverage reviews.
DRAFT_AUDIT_MODEL=
DRAFT_COVERAGE_MODEL=
